{
  "Environment": {
    "BaseUrl": "https://www.epam.com/"
  },
  "Browser": {
    "Name": "chrome",
    "ExplicitWaitSeconds": 15,
    "Maximize": true,
    "Downloads": {
      "Directory": "Downloads"
    },
    "Options": {
      "Arguments": [
        "--disable-notifications"
      ],
      "Preferences": {
        "download.prompt_for_download": "false"
      }
    }
  },
  "Logging": {
    "MinLevel": "Info"
  },
  "Screenshots": {
    "Directory": "Screenshots"
  }
}
